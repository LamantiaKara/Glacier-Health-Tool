    Map.addLayer(firstMask, {bands: ['greenEks', 'redEks', 'blueEks'], min:0, max:1}, 'First Image RGB');
    Map.addLayer(firstMask.select('NDSI_masked').selfMask(), {min: 0, max: 1, palette: ['white', '#1d91c0']}, 'First Image Total area mask');
    Map.addLayer(firstMask.select('NIR_masked').selfMask(), {min: 0, max: 1, palette: ['white', '#c7e9b4']}, 'First Image Snow mask');

//Exports
    Export.table.toDrive({
