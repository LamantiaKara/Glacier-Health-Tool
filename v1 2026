//run analysis function
var runAnalysis = ui.Button({
  label: 'Step 6: Run Analysis',
  onClick: function (){
    Map.layers().reset();

    if (!CollectedImages) {
      print('Error - Please run "Collect Imagery" first');
      return;
    }
    if (!selectedGlacierGlobal) {
      print('Error - Please select a glacier first');
      return;
    }
    if (!demSelect.getValue()) {
      print('Error - Please select a DEM source before running analysis');
      return;
    }
    if (applyMasking===null) {
      print('Error - Please select a masking strenth before running analysis.');
      return;
    }
    var combine_glaciers = selectedGlacierGlobal;
    var roi = combine_glaciers;
    var area = roi.geometry()
    var roiMask = ee.Image(ee.FeatureCollection(
                    ee.Feature(area).set('value', 1)
                    ).reduceToImage(['value'], ee.Reducer.first())
                );
    
    var demSource = demSelect.getValue();
    var dem;
    if (demSource === 'ArcticDEM'){
      dem =  ee.Image('UMN/PGC/ArcticDEM/V4/2m_mosaic').select('elevation');
    } else if (demSource === 'COPDEM') {
      dem = ee.ImageCollection("COPERNICUS/DEM/GLO30").filterBounds(area).mosaic().select('DEM').rename('elevation');
    } else if (demSource == 'NASADEM'){
      dem = ee.Image('NASA/NASADEM_HGT/001').select('elevation')
    }
    var imgCrs = ee.Image(CollectedImages.first()).select('NIR').projection();
    dem = dem.reproject(imgCrs).updateMask(roiMask);
    var slope  = ee.Terrain.slope(dem)
    var aspect = ee.Terrain.aspect(dem)
    //addition for Four 5 Band (NIR/SWIR) for total area calculation later
    //clamping to avoid divison by zero and snow/ice reflectance ceiling
    var addFour5Band = function(image) {
      var b4 = image.select('NIR').clamp(0.0001, 0.3);
      var b5 = image.select('SWIR1').clamp(0.0001, 0.3);
      var four5 = b4.divide(b5).rename('Four5');
      return image.addBands(four5);
    };
    var OneImageYearlyFour5 = CollectedImages.map(addFour5Band);
    
    var deg2rad = ee.Number(Math.PI/180);
    //topographic correction - Ekstrand
    var ekstrandCorrection = function(image, slope, aspect, geom, bandList) {
      var cos_e = ee.Image(slope).multiply(deg2rad).cos();
      var sin_e = ee.Image(slope).multiply(deg2rad).sin();
      var cos_z = ee.Image.constant(ee.Number(90).subtract(ee.Number(ee.Image(image)
          .get('SUN_ELEVATION'))).multiply(deg2rad)).cos();
      var sin_z = ee.Image.constant(ee.Number(90).subtract(ee.Number(ee.Image(image)
          .get('SUN_ELEVATION'))).multiply(deg2rad)).sin();
      var cos_AziMinusAsp = ee.Image.constant(ee.Number(ee.Image(image)
          .get('SUN_AZIMUTH')).multiply(deg2rad))
              .subtract(ee.Image(aspect).multiply(deg2rad)).cos();
      var cos_i = cos_e.multiply(cos_z)
          .add(sin_e.multiply(sin_z).multiply(cos_AziMinusAsp));
      var x = cos_i.multiply(cos_e).log().rename('x');

      var bandNames = ee.List(ee.Image(image).select(bandList).bandNames());
      var bandNamesOut = bandNames.map(function(band){ return ee.String(band).cat('Eks'); });

      var bandsOut = ee.ImageCollection(bandNames.map(function(band){
        var y = ee.Image(ee.Image(image).select([band]).multiply(cos_e)).log().rename('y');
        // OLS slope via linearFit over all ROI pixels ('scale' = slope, 'offset' = intercept)
        var k = ee.Number(x.addBands(y).reduceRegion({
            reducer: ee.Reducer.linearFit(), geometry: geom, scale: 30, maxPixels: 1e13
          }).get('scale'));
        var ekstrand = ee.Image(image).select([band])
            .multiply((cos_z.divide(cos_i)).pow(cos_i.multiply(k)))
            .rename('ekstrand');
        return ee.Image(ekstrand).set('k', k);
      }));

      var kVals = bandsOut.aggregate_array('k');
      var eksBands = bandsOut.toBands().rename(bandNamesOut);
      return eksBands.set(ee.Dictionary.fromLists(bandNamesOut, ee.List(kVals)))
        .addBands(image.select('Four5'))
        .copyProperties(image, ['system:time_start', 'system:index', 'system:id', 'LANDSAT_PRODUCT_ID',
          'DATE_ACQUIRED', 'SUN_ELEVATION', 'SUN_AZIMUTH', 'CLOUD_COVER_LAND','cloud_pct_roi',
          'LANDSAT_SCENE_ID', 'SPACECRAFT_ID']);
    };
    var analysisBands = ['blue', 'green', 'red', 'NIR','SWIR1', 'SWIR2', 'thermal'];
    var CorrectedImages = OneImageYearlyFour5.map(function(image){
      return ekstrandCorrection(image, slope, aspect, roi, analysisBands);
    });
    //rock and water masking
    var createApplyMasks = function(image){
      var ratio = image.select('thermalEks').divide(image.select('blueEks'));
      var rock_mask = ratio.gt(th_blu_rat).and(image.select('blueEks').lt(blue_limit));
      return image.updateMask(rock_mask.not()).addBands(rock_mask.rename('rock_water_mask'));
    };

    var bestImageYearly = applyMasking
      ? CorrectedImages.map(createApplyMasks)
      : CorrectedImages;
     //otsu calculation 
    var calc_otsu = function(hist) {
      var counts = ee.Array(ee.Dictionary(hist).get('histogram'));
      var means = ee.Array(ee.Dictionary(hist).get('bucketMeans'));
      var size = means.length().get([0]);
      var total = counts.reduce(ee.Reducer.sum(), [0]).get([0]);
      var sum = means.multiply(counts).reduce(ee.Reducer.sum(), [0]).get([0]);
      var mean = sum.divide(total);
      var indices = ee.List.sequence(1,size);
      var bss = indices.map(function(i) {
        var aCounts = counts.slice(0, 0, i);
        var aCount = aCounts.reduce(ee.Reducer.sum(), [0]).get([0]);
        var aMeans = means.slice(0, 0, i);
        var aMean = aMeans.multiply(aCounts).reduce(ee.Reducer.sum(), [0])
            .get([0]).divide(aCount);
        var bCount = total.subtract(aCount);
        var bMean = sum.subtract(aCount.multiply(aMean)).divide(bCount);
        return aCount.multiply(aMean.subtract(mean).pow(2)).add(
               bCount.multiply(bMean.subtract(mean).pow(2)));
      });
      return means.sort(bss).get([-1]);
    };
    //NIR band histogram assessment for bimodal distribution
    var OTSU_MIN_CLASS_FRACTION = 0.02;
    var OTSU_MIN_PEAK_BALANCE = 0.10;
    var OTSU_MIN_CLASS_FRACTION_DOMINANT_PEAK = 0.05;
    var OTSU_MIN_PEAK_BALANCE_DOMINANT_PEAK = 0.20;
 
    var bimodality = function(hist, threshold){
      hist = ee.Dictionary(hist);
      var counts = ee.Array(hist.get('histogram'));
      var means  = ee.Array(hist.get('bucketMeans'));
      var size   = ee.Number(means.length().get([0]));
      var total  = ee.Number(counts.reduce(ee.Reducer.sum(), [0]).get([0]));
      threshold  = ee.Number(threshold);
 
      // split index = number of buckets whose center < threshold
      // (i.e. the darker ice/firn class). splitIndex is therefore the
      // first index belonging to the bright/snow class.
      var belowMask = means.lt(threshold);                       // 1 where center < threshold
      var splitIndex = ee.Number(belowMask.reduce(ee.Reducer.sum(), [0]).get([0]));
      // clamp into interior so slices are valid
      splitIndex = splitIndex.max(1).min(size.subtract(1));
 
      // class counts either side of the split
      var classA = ee.Number(counts.slice(0, 0, splitIndex).reduce(ee.Reducer.sum(), [0]).get([0]));
      var classB = total.subtract(classA);
      var classBalance = classA.min(classB).divide(total);
 
      // peak heights either side
      var leftPeak  = ee.Number(counts.slice(0, 0, splitIndex).reduce(ee.Reducer.max(), [0]).get([0]));
      var rightPeak = ee.Number(counts.slice(0, splitIndex).reduce(ee.Reducer.max(), [0]).get([0]));
      var peakBalance = leftPeak.min(rightPeak).divide(ee.Number(1).max(leftPeak.max(rightPeak)));
 
      var reason = ee.String(ee.Algorithms.If(
        peakBalance.lt(OTSU_MIN_PEAK_BALANCE),
        'secondary_peak_too_small',
      ee.Algorithms.If(
        classBalance.lt(OTSU_MIN_CLASS_FRACTION_DOMINANT_PEAK)
          .and(peakBalance.lt(OTSU_MIN_PEAK_BALANCE_DOMINANT_PEAK)),
        'secondary_peak_too_small',
      ee.Algorithms.If(
        classBalance.lt(OTSU_MIN_CLASS_FRACTION),
        'class_imbalance',
        'ok'))));
 
      var ok = ee.Number(ee.Algorithms.If(reason.compareTo('ok').eq(0), 1, 0));
 
      return ee.Dictionary({
        ok: ok,
        reason: reason,
        class_balance: classBalance,
        peak_balance: peakBalance
      });
    };
    //process images to get snow cover and total area masks
    var processImages = function(image) {
      var green = image.select('greenEks');
      var swir = image.select('SWIR1Eks');
      var ndsi = green.subtract(swir).divide(green.add(swir)).rename('NDSI');
      var four5 = image.select('Four5');
      //total area from NDSI and NIR/SWIR threshold
      var ndsi_mask = ndsi.gt(0.4).and(four5.gt(1.4)).selfMask().rename('NDSI_masked');
      var DEM = dem.rename('dem')
      var bandName = 'NIREks'
      var nir = image.select(bandName)
      //Use total area to find snow cover area
      var nir_glacier = nir.updateMask(ndsi_mask)
      var hist = nir_glacier.reduceRegion({
        reducer: ee.Reducer.histogram(), 
        geometry: roi, scale: 30, maxPixels: 1e13
      }).get(bandName);

      var otsu = ee.Algorithms.If(
        ee.Algorithms.IsEqual(hist, null), null, calc_otsu(hist)
      );
      // bimodality QA: flag if NIR isn't bimodal
      var bim = ee.Dictionary(ee.Algorithms.If(
        ee.Algorithms.IsEqual(hist, null),
        ee.Dictionary({ok: 0, reason: 'empty_histogram', class_balance: -1, peak_balance: -1}),
        bimodality(hist, ee.Algorithms.If(ee.Algorithms.IsEqual(otsu, null), 0, otsu))
      ));
      var bimOk = ee.Number(bim.get('ok'))
      //snow cover mask
      var nir_masked = ee.Image(ee.Algorithms.If(
        otsu,
        nir.updateMask(ndsi_mask)
          .gt(ee.Number(otsu))
          .selfMask().rename('NIR_masked'),
        ee.Image(0).updateMask(ee.Image(0)).rename('NIR_masked')
      ));
      var SCAdem = DEM.updateMask(nir_masked).rename('SCAdem');
      var NDSIdem = DEM.updateMask(ndsi_mask).rename('NDSIdem');

      return image
        .addBands([ndsi, ndsi_mask, nir_masked, SCAdem, NDSIdem, DEM])
        .set('otsu_'+ bandName, otsu)
        .set('bimodal_ok', bimOk)
        .set('rejection_reason', bim.get('reason'))
        .set('class_balance', bim.get('class_balance'))
        .set('peak_balance', bim.get('peak_balance'))
        .copyProperties(image, [
      'system:time_start', 'system:index', 
      'LANDSAT_PRODUCT_ID', 'DATE_ACQUIRED','CLOUD_COVER_LAND','cloud_pct_roi',
      'LANDSAT_SCENE_ID', 'SPACECRAFT_ID'
    ]);
    };
    var AllMasks = bestImageYearly.map(processImages).map(function(image) {
      image = ee.Image(image);
      var constrained = image.select('NIR_masked')
                             .multiply(image.select('NDSI_masked'))
                             .rename('NIR_masked');
      image = image.addBands({
        srcImg: constrained, 
        overwrite: true});
      //pixel count for area
      var counts = image.select(['NDSIdem']).reduceRegion({
        reducer: ee.Reducer.count(),
        geometry: roi,
        scale: 30,
        maxPixels: 1e13
      });
      return image.set({
        'NDSIdem_count': counts.get('NDSIdem')
      });
    }).filter(ee.Filter.gt('NDSIdem_count', 0));
    // calculate areas
    function calculateAreas(image){
      var SCAdem = image.select('SCAdem');
      var NDSIdem = image.select('NDSIdem');
      var snow_pixels = SCAdem.gt(0).multiply(ee.Image.pixelArea());
      var NDSI_pixels = NDSIdem.gt(0).multiply(ee.Image.pixelArea());

      var snowAndTotalArea = ee.Image(snow_pixels).addBands(NDSI_pixels)
        .reduceRegion({
          reducer: ee.Reducer.sum(), 
          geometry: roi, 
          scale: 30, 
          maxPixels: 1e13
      });

      var snowArea = ee.Number(snowAndTotalArea.get('SCAdem')).divide(1e6);
      var ndsiArea = ee.Number(snowAndTotalArea.get('NDSIdem')).divide(1e6);
      var validTotalArea = ndsiArea.gt(0);//ensure non zero results
      //calculate AAR
      var aar = ee.Algorithms.If(
        validTotalArea,
        snowArea.divide(ndsiArea),
        null
      );
      aar = ee.Number(aar);
      var validAAR = validTotalArea
        .and(aar.gte(0))
        .and(aar.lt(1));

      var aarPercent = ee.Number(aar).multiply(100);
      var backfillPercent = ee.Algorithms.If(validAAR, 
        ee.Number(100).subtract(aarPercent).clamp(0, 100), null);
      //Calculate snowline
      var snowline = ee.Algorithms.If(validAAR,
        NDSIdem.reduceRegion({
          reducer: ee.Reducer.percentile([backfillPercent]),
          geometry: roi, 
          scale: 30, 
          maxPixels: 1e13
        }).get('NDSIdem'),
        null);
      //add errors
      var snowAreaErr = snowArea.multiply(0.07);
      var ndsiAreaErr = ndsiArea.multiply(0.03);
      var snowlineErr = ee.Algorithms.If(validAAR, ee.Number(snowline).multiply(0.01), null);
      
      return ee.Feature(null, {
        'imageID': image.get('LANDSAT_PRODUCT_ID'),
        'imageDate': image.get('DATE_ACQUIRED'),
        'CloudCover': image.get('CLOUD_COVER_LAND'),
        'CloudPct_ROI': image.get('cloud_pct_roi'),
        'SnowCoverArea_km2': snowArea,
        'SnowCoverArea_Error_km2':snowAreaErr,
        'TotalArea_km2': ndsiArea,
        'TotalArea_Error_km2':ndsiAreaErr,
        'AAR': aar,
        'Snowline_m': snowline,
        'Snowline_Error_m': snowlineErr,
        'BimodalOK': image.get('bimodal_ok'),
        'RejectionReason': image.get('rejection_reason'),
        'ClassBalance': image.get('class_balance'),
        'PeakBalance': image.get('peak_balance'),
        'validAAR': validAAR
      });
    }
    
      var AllAreas = AllMasks
      .map(calculateAreas)
      .filter(ee.Filter.eq('validAAR', 1));
    
    var limited = AllAreas.limit(1);
    print('Test Result Print', limited)
    var nImages = AllMasks.size();
    print('Number of images analyzed:', nImages);
    
    // QA diagnostics: see how often bimodality rejection fires (can remove later)
    print('Bimodality reasons:', AllMasks.aggregate_array('rejection_reason'));

    var ResultsCollection = AllAreas
    //print('Analysis Complete! \n Go to Tasks Tab for Exports')
    statusLabel.setValue('Analysis Complete!\nGo to the Tasks tab to run your exports.');
    
