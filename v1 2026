//common band naming
var commonBands = ['blue', 'green', 'red', 'NIR', 'SWIR1', 'SWIR2', 'thermal']
var renameLS5_7 = ['SR_B1', 'SR_B2','SR_B3', 'SR_B4','SR_B5', 'SR_B7', 'ST_B6']
var renameLS8_9 = ['SR_B2', 'SR_B3','SR_B4', 'SR_B5','SR_B6', 'SR_B7', 'ST_B10']

//imagery collection
function harmonizeLandsat(image, satellite, roi, roiMaskImage){
  var optical, thermal;
  if (satellite == 'LS5_7'){
    optical = image.select(renameLS5_7.slice(0,6)).multiply(0.0000275).add(-0.2)
                   .rename(commonBands.slice(0,6));
    thermal = image.select('ST_B6').multiply(0.00341802).add(149.0).rename('thermal');
  } else if (satellite =='LS8_9'){
    optical = image.select(renameLS8_9.slice(0,6)).multiply(0.0000275).add(-0.2)
                   .rename(commonBands.slice(0,6));
    thermal = image.select('ST_B10').multiply(0.00341802).add(149.0).rename('thermal');
  }
  optical = optical.max(0);

  var combined = optical.addBands(thermal).updateMask(roiMaskImage);
//cloud fraction from QA PIXEL band
  var cloudBit = image.select('QA_PIXEL').bitwiseAnd(1<<3).neq(0)// 1 is high confidence of cloud
                      .updateMask(roiMaskImage).rename('cloud');

  var nanBand = combined.select(['blue','green','red','NIR','SWIR1','SWIR2'])
                    .mask().reduce(ee.Reducer.min()).rename('valid');
  var stats = nanBand.addBands(cloudBit).reduceRegion({
    reducer: ee.Reducer.mean().setOutputs(['valid'])
    .combine({reducer2: ee.Reducer.mean().setOutputs(['cloud']),
     sharedInputs: false
  }),
    geometry:roi,
    scale: 30, 
    maxPixels: 1e13
  });
  var coverage = ee.Number(ee.Algorithms.If(stats.get('valid'), stats.get('valid'), 0));
  var cloudFraction = ee.Number(ee.Algorithms.If(stats.get('cloud'),
            stats.get('cloud'), 0)).multiply(100); //percent of roi with cloud flags
  return combined.set('roi_coverage', coverage)
                 .set('cloud_pct_roi', cloudFraction)
                 .copyProperties(image, ['system:time_start', 'system:index', 'system:id',
                 'LANDSAT_PRODUCT_ID', 'DATE_ACQUIRED', 'SUN_ELEVATION', 
                 'SUN_AZIMUTH', 'CLOUD_COVER_LAND', 'LANDSAT_SCENE_ID', 'SPACECRAFT_ID'])
                 .set('month', ee.Date(image.get('system:time_start')).get('month'));
}
