var CollectedImages;
var getImages = ui.Button({
  label: 'Step 3: Collect Imagery',
  onClick: function (){
    imageryMode = true;
    Map.remove(bufferPanel);
    if (selectedGlacierGlobal === null) {
    print('⚠️ Please select a glacier by clicking on the map');
    return;
    }
    Map.layers().reset();
    print('Imagery Collection Inititated')
    var combine_glaciers = selectedGlacierGlobal
    glaciername = glacierNameInput.getValue();
    startYear = startYearSlider.getValue();
    endYear = endYearSlider.getValue();
    targetMonth = monthSlider.getValue();
    cloudcover = cloudSlider.getValue();
    minSunAngle = sunSlider.getValue();
    var roi = combine_glaciers;
    var roiMaskImage = ee.Image.constant(1).clip(roi).selfMask();
    var years = ee.List.sequence(startYear, endYear, 1);
    
    var monthStart = Math.max(1, targetMonth-1);
    var monthEnd = Math.min(12, targetMonth +1);
    var im_col = ee.List(years).map(function(yr){
      var area = roi;
      
      var l5 = ee.ImageCollection("LANDSAT/LT05/C02/T1_L2")
        .filterBounds(area)
        .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
        .filter(ee.Filter.calendarRange(monthStart, monthEnd, 'month'))
        .filter(ee.Filter.gte('SUN_ELEVATION', minSunAngle))
        .filter(ee.Filter.lte('CLOUD_COVER_LAND', cloudcover))
        .map(function (image) {
            return harmonizeLandsat(image, 'LS5_7', roi, roiMaskImage);
        });
      var l7 = ee.ImageCollection("LANDSAT/LE07/C02/T1_L2")
        .filterBounds(area)
        .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
        .filter(ee.Filter.calendarRange(monthStart, monthEnd, 'month'))
        .filter(ee.Filter.gte('SUN_ELEVATION', minSunAngle))
        .filter(ee.Filter.lte('CLOUD_COVER_LAND', cloudcover))
          // keep only images before scan corrector error
        .filter(ee.Filter.lte('system:time_start', ee.Date.fromYMD(2002, 12, 31).millis()))
        .map(function (image) {
            return harmonizeLandsat(image, 'LS5_7', roi, roiMaskImage);
        });
      var l8 = ee.ImageCollection("LANDSAT/LC08/C02/T1_L2")
        .filterBounds(area)
        .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
        .filter(ee.Filter.calendarRange(monthStart, monthEnd, 'month'))
        .filter(ee.Filter.gte('SUN_ELEVATION', minSunAngle))
        .filter(ee.Filter.lte('CLOUD_COVER_LAND', cloudcover))
        .map(function (image) {
            return harmonizeLandsat(image, 'LS8_9', roi, roiMaskImage);
        });
      var l9 = ee.ImageCollection("LANDSAT/LC09/C02/T1_L2") 
         .filterBounds(area)
        .filter(ee.Filter.calendarRange(startYear, endYear, 'year'))
        .filter(ee.Filter.calendarRange(monthStart, monthEnd, 'month'))
        .filter(ee.Filter.gte('SUN_ELEVATION', minSunAngle))
        .filter(ee.Filter.lte('CLOUD_COVER_LAND', cloudcover))
        .map(function (image) {
            return harmonizeLandsat(image, 'LS8_9', roi, roiMaskImage);
        });     
      var merged = l5.merge(l7).merge(l8).merge(l9);
      var filtered = merged.filter(ee.Filter.gte('roi_coverage', coverage_min));
      return ee.List(ee.Algorithms.If(filtered.size().gt(0),
                                 filtered.toList(filtered.size()),
                                 ee.List([])));
    });
    var im_col_flat = ee.ImageCollection(ee.List(im_col).flatten())
      .distinct('LANDSAT_SCENE_ID')
      .sort('system:time_start', true);
    im_col_flat = im_col_flat.map(function(image){
      return image.set('image_id', image.get('system:id'));
    });
    var total_images = im_col_flat.size()
    print('Total filtered images found:', total_images);
//get one image per year, prefer target month
var OneImagePerYear = ee.List(years).map(function(yr) {
  yr = ee.Number(yr);
  
  var filteredForYear = im_col_flat.filter(ee.Filter.calendarRange(yr, yr, 'year'));
  var filteredForMonth = filteredForYear.filter(ee.Filter.calendarRange(targetMonth, targetMonth, 'month'));
  var bestInMonth = filteredForMonth.sort('CLOUD_COVER_LAND', true).first();
  var bestInYear = filteredForYear.sort('CLOUD_COVER_LAND', true).first();
  var bestInMonthCloud = ee.Number(ee.Algorithms.If(
    filteredForMonth.size().gt(0),
    bestInMonth.get('CLOUD_COVER_LAND'),
    ee.Number(9999)
  ));
  return ee.Algorithms.If(
    filteredForMonth.size().gt(0).and(bestInMonthCloud.lte(cloudcover-5)),
    bestInMonth,
    bestInYear
    );
});
    var OneImageYearly = ee.ImageCollection(OneImagePerYear).sort('system:time_start');
    var cloudCoverList = OneImageYearly.aggregate_array('CLOUD_COVER_LAND');
    var monthList = OneImageYearly.aggregate_array('system:time_start').map(function(t) {
    return ee.Date(t).get('month');
});
    var monthCounts = monthList.reduce(ee.Reducer.frequencyHistogram());
    
    CollectedImages = OneImageYearly;
    print('Yearly imagery collection:', OneImageYearly);
    print('Cloud Cover % Per Year', cloudCoverList);
    print('Image Month Distribution', monthCounts);
    Map.centerObject(roi);
    Map.addLayer(roi.style({color: '000000',fillColor: '00000000'}), {}, 'ROI Outline');
    Map.addLayer(OneImageYearly.first(), {bands: ['red', 'green', 'blue'], min:0, max:1}, 'First Image RGB');
    statusLabel.setValue('Step 3 Complete: Imagery collected. \nStep 4:  Select a DEM .')

