//update buffer if slider is moved
function updateBufferedGlacier() {
  if (!selectedGlacierRaw) return;
  var geom;
  if (roi_buffer === 0){
    geom = selectedGlacierRaw.geometry();
  } else {
    var buffered =selectedGlacierRaw.geometry().buffer(roi_buffer);
    var searchArea = selectedGlacierRaw.geometry().buffer(roi_buffer + 50);
    var nearbyGlaciers = RGI.filterBounds(searchArea)
                            .filter(ee.Filter.neq('rgi_id', selectedGlacierRaw.get('rgi_id')));
    geom = buffered.difference(nearbyGlaciers.geometry(), 1)   
  }

  selectedGlacierGlobal = ee.FeatureCollection([
    ee.Feature(geom, selectedGlacierRaw.toDictionary())
  ]);

  Map.layers().reset();
  Map.centerObject(selectedGlacierGlobal);
  if (!imageryMode){
    Map.addLayer(RGI, {}, 'RGI')
  }
  Map.addLayer(selectedGlacierGlobal, {color: 'red'}, 'Buffered');
}
